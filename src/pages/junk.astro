---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { getCollection } from "astro:content";

const items = (await getCollection("junk")).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const fmt = (iso: string) =>
  new Date(iso).toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "2-digit",
  });
---

<Layout title="Junk — tybura®">
  <Navbar />

  <main class="main-wrapper">
    <header class="junk-header">
      <p>Junk — things I own, apparently.</p>
      <p class="junk-count">{items.length} item{items.length === 1 ? "" : "s"}</p>
    </header>

    <section class="junk-grid">
      {
        items.length === 0 ? (
          <p class="junk-empty">Nothing here yet.</p>
        ) : (
          items.map((item) => (
            <figure class="item">
              <button
                class="item-btn"
                data-full={item.data.image}
                data-title={item.data.title}
                aria-label={item.data.title || "View item"}
              >
                <img
                  src={item.data.thumb}
                  width={item.data.width}
                  height={item.data.height}
                  alt={item.data.title || "Object"}
                  loading="lazy"
                  decoding="async"
                />
              </button>
              <figcaption class="item-meta">
                <span>{item.data.title || "Untitled"}</span>
                <span>{fmt(item.data.date)}</span>
              </figcaption>
            </figure>
          ))
        )
      }
    </section>
  </main>

  <Footer />

  <dialog id="lightbox">
    <button id="lightbox-close" aria-label="Close">Close</button>
    <img id="lightbox-img" src="" alt="" />
    <p id="lightbox-title"></p>
  </dialog>
</Layout>

<script>
  const lightbox = document.getElementById("lightbox") as HTMLDialogElement;
  const lightboxImg = document.getElementById("lightbox-img") as HTMLImageElement;
  const lightboxTitle = document.getElementById("lightbox-title")!;

  document.querySelectorAll<HTMLButtonElement>(".item-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      lightboxImg.src = btn.dataset.full || "";
      lightboxTitle.textContent = btn.dataset.title || "";
      lightbox.showModal();
    });
  });
  document.getElementById("lightbox-close")!.addEventListener("click", () => lightbox.close());
  lightbox.addEventListener("click", (e) => {
    if (e.target === lightbox) lightbox.close();
  });

  // fade items in as they enter the viewport
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add("visible");
          observer.unobserve(entry.target);
        }
      }
    },
    { rootMargin: "80px" }
  );
  document.querySelectorAll(".item").forEach((el) => observer.observe(el));
</script>

<style is:global>
  /* /junk keeps the homepage system but flips the palette to white/black */
  :root {
    --color-bg: #ffffff;
    --color-text: #111111;
    --color-accent: #111111;
  }
</style>

<style>
  .main-wrapper {
    display: flex;
    flex-direction: column;
    padding: calc(38px + var(--content-padding)) var(--content-padding) var(--content-padding);
    width: 100%;
    min-height: calc(100vh - 60px);
  }

  .junk-header {
    display: flex;
    justify-content: space-between;
    gap: var(--gap);
    padding-bottom: calc(var(--gap) * 4);
  }

  .junk-count {
    opacity: 0.5;
  }

  .junk-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: calc(var(--gap) * 4) var(--gap);
    width: 100%;
  }

  .junk-empty {
    grid-column: 1 / -1;
    opacity: 0.5;
  }

  .item {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  .item.visible {
    opacity: 1;
    transform: none;
  }

  .item-btn {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    border: 0;
    background: none;
    cursor: pointer;
    padding: 0;
  }

  .item-btn img {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    margin: 0 auto;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    transition: transform 0.25s ease;
  }
  .item-btn:hover img {
    transform: scale(1.03);
  }

  .item-meta {
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .item-meta span:last-child {
    opacity: 0.5;
  }

  dialog {
    margin: auto;
    border: 1px solid var(--color-text);
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-family);
    font-size: var(--font-size);
    font-weight: var(--font-weight);
    line-height: var(--line-height);
    letter-spacing: var(--letter-spacing);
    max-width: min(90vw, 900px);
    max-height: 90vh;
    padding: calc(var(--gap) * 3);
    text-align: center;
  }
  dialog::backdrop {
    background: rgba(255, 255, 255, 0.92);
  }
  dialog img {
    max-width: 100%;
    max-height: 70vh;
    width: auto;
    height: auto;
    margin: 0 auto;
    display: block;
  }
  #lightbox-title {
    margin-top: var(--gap);
  }
  #lightbox-close {
    position: absolute;
    top: var(--content-padding);
    right: var(--content-padding);
    border: 0;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
    background: none;
    font: inherit;
    letter-spacing: inherit;
    color: var(--color-text);
    cursor: pointer;
    padding: 0;
  }
  #lightbox-close:hover {
    border-bottom-color: var(--color-text);
  }

  @media (max-width: 1024px) {
    .junk-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 640px) {
    .junk-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
