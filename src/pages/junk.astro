---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { getCollection } from "astro:content";

const items = (await getCollection("junk")).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const fmt = (iso: string) =>
  new Date(iso).toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "2-digit",
  });
---

<Layout title="Junk — tybura®">
  <Navbar />

  <main class="main-wrapper">
    <header class="junk-header">
      <p>Junkyard is an online album of interesting objects I own or just noticed somewhere.</p>
      <div class="junk-header-right">
        <div class="junk-swatches" id="junk-swatches"></div>
        <p class="junk-sort">
          <button class="sort-btn is-active" data-sort="latest">Latest</button>
          <span class="sort-sep">/</span>
          <button class="sort-btn" data-sort="color">Color</button>
        </p>
        <p class="junk-count">{items.length} item{items.length === 1 ? "" : "s"}</p>
      </div>
    </header>

    <section class="junk-grid">
      {
        items.length === 0 ? (
          <p class="junk-empty">Nothing here yet.</p>
        ) : (
          items.map((item) => (
            <figure class="item" data-date={item.data.date} data-color={item.data.color}>
              <button
                class="item-btn"
                data-full={item.data.image}
                data-title={item.data.title}
                aria-label={item.data.title || "View item"}
              >
                <img
                  src={item.data.thumb}
                  width={item.data.width}
                  height={item.data.height}
                  alt={item.data.title || "Object"}
                  loading="lazy"
                  decoding="async"
                />
              </button>
              <figcaption class="item-meta">
                <span>{item.data.title || "Untitled"}</span>
                <span>{fmt(item.data.date)}</span>
              </figcaption>
            </figure>
          ))
        )
      }
    </section>
  </main>

  <Footer />

  <dialog id="lightbox">
    <button id="lightbox-close" aria-label="Close">Close</button>
    <img id="lightbox-img" src="" alt="" />
    <div class="lightbox-nav">
      <button id="lightbox-prev" aria-label="Previous item">&larr; Prev</button>
      <p id="lightbox-title"></p>
      <button id="lightbox-next" aria-label="Next item">Next &rarr;</button>
    </div>
  </dialog>
</Layout>

<script>
  const lightbox = document.getElementById("lightbox") as HTMLDialogElement;
  const lightboxImg = document.getElementById("lightbox-img") as HTMLImageElement;
  const lightboxTitle = document.getElementById("lightbox-title")!;

  let buttons = [...document.querySelectorAll<HTMLButtonElement>(".item-btn")];
  let current = 0;
  const loaded = new Set<string>();

  function preload(index: number) {
    const src = buttons[(index + buttons.length) % buttons.length].dataset.full || "";
    if (loaded.has(src)) return;
    const img = new Image();
    img.onload = () => loaded.add(src);
    img.src = src;
  }

  function show(index: number) {
    current = (index + buttons.length) % buttons.length;
    const btn = buttons[current];
    const full = btn.dataset.full || "";
    lightboxTitle.textContent = btn.dataset.title || "";

    if (loaded.has(full)) {
      lightboxImg.src = full;
    } else {
      // show the cached grid thumbnail immediately, swap in the full-size
      // image once it has downloaded (unless the user has moved on)
      lightboxImg.src = btn.querySelector("img")!.currentSrc || full;
      const hi = new Image();
      hi.onload = () => {
        loaded.add(full);
        if (buttons[current] === btn) lightboxImg.src = full;
      };
      hi.src = full;
    }
    preload(current + 1);
    preload(current - 1);
  }

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      show(buttons.indexOf(btn));
      lightbox.showModal();
    });
  });

  // --- sorting ---
  const grid = document.querySelector(".junk-grid")!;

  function hueKey(el: Element) {
    const hex = (el as HTMLElement).dataset.color;
    if (!hex) return 9999;
    const r = parseInt(hex.slice(1, 3), 16) / 255;
    const g = parseInt(hex.slice(3, 5), 16) / 255;
    const b = parseInt(hex.slice(5, 7), 16) / 255;
    const max = Math.max(r, g, b);
    const min = Math.min(r, g, b);
    const l = (max + min) / 2;
    const d = max - min;
    const s = d === 0 ? 0 : d / (1 - Math.abs(2 * l - 1));
    if (s < 0.15) return 360 + (1 - l) * 100; // grays after colors, light -> dark
    let h = 0;
    if (max === r) h = ((g - b) / d) % 6;
    else if (max === g) h = (b - r) / d + 2;
    else h = (r - g) / d + 4;
    return (h * 60 + 360) % 360;
  }

  function applySort(mode: string) {
    const figs = [...grid.querySelectorAll(".item")];
    figs
      .sort((a, b) =>
        mode === "color"
          ? hueKey(a) - hueKey(b)
          : +new Date((b as HTMLElement).dataset.date || 0) - +new Date((a as HTMLElement).dataset.date || 0)
      )
      .forEach((f) => grid.appendChild(f));
    buttons = [...document.querySelectorAll<HTMLButtonElement>(".item-btn")];
  }

  document.querySelectorAll<HTMLButtonElement>(".sort-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".sort-btn").forEach((b) => b.classList.toggle("is-active", b === btn));
      applySort(btn.dataset.sort || "latest");
    });
  });

  // --- color filter swatches ---
  const BUCKETS: [string, string][] = [
    ["red", "#b02020"],
    ["orange", "#d07020"],
    ["yellow", "#e8c808"],
    ["green", "#3a7a3a"],
    ["blue", "#2050a0"],
    ["purple", "#7040a0"],
    ["pink", "#d060a0"],
    ["brown", "#6b4a2f"],
    ["white", "#ffffff"],
    ["gray", "#999999"],
    ["black", "#111111"],
  ];

  function bucketOf(hex?: string) {
    if (!hex) return "gray";
    const r = parseInt(hex.slice(1, 3), 16) / 255;
    const g = parseInt(hex.slice(3, 5), 16) / 255;
    const b = parseInt(hex.slice(5, 7), 16) / 255;
    const max = Math.max(r, g, b);
    const min = Math.min(r, g, b);
    const l = (max + min) / 2;
    const d = max - min;
    const s = d === 0 ? 0 : d / (1 - Math.abs(2 * l - 1));
    if (l > 0.88) return "white";
    if (l < 0.13) return "black";
    if (s < 0.15) return "gray";
    let h = 0;
    if (max === r) h = ((g - b) / d) % 6;
    else if (max === g) h = (b - r) / d + 2;
    else h = (r - g) / d + 4;
    h = (h * 60 + 360) % 360;
    if (h >= 15 && h < 50 && l < 0.35) return "brown";
    if (h >= 345 || h < 15) return "red";
    if (h < 45) return "orange";
    if (h < 70) return "yellow";
    if (h < 165) return "green";
    if (h < 255) return "blue";
    if (h < 290) return "purple";
    return "pink";
  }

  const figs = [...grid.querySelectorAll<HTMLElement>(".item")];
  figs.forEach((f) => (f.dataset.bucket = bucketOf(f.dataset.color)));
  const present = new Set(figs.map((f) => f.dataset.bucket));

  const swatchRow = document.getElementById("junk-swatches")!;
  const countEl = document.querySelector(".junk-count")!;
  const totalLabel = countEl.textContent;

  function applyFilter(bucket: string | null) {
    let visible = 0;
    figs.forEach((f) => {
      const showIt = !bucket || f.dataset.bucket === bucket;
      f.style.display = showIt ? "" : "none";
      if (showIt) visible++;
    });
    buttons = [...grid.querySelectorAll<HTMLButtonElement>(".item:not([style*='none']) .item-btn")];
    countEl.textContent = bucket ? `${visible} item${visible === 1 ? "" : "s"}` : totalLabel;
    swatchRow.querySelectorAll(".swatch").forEach((s) =>
      s.classList.toggle("is-active", (s as HTMLElement).dataset.bucket === (bucket || ""))
    );
  }

  const allBtn = document.createElement("button");
  allBtn.className = "swatch swatch-all is-active";
  allBtn.dataset.bucket = "";
  allBtn.textContent = "All";
  allBtn.addEventListener("click", () => applyFilter(null));
  swatchRow.appendChild(allBtn);

  for (const [name, color] of BUCKETS) {
    if (!present.has(name)) continue;
    const b = document.createElement("button");
    b.className = "swatch";
    b.dataset.bucket = name;
    b.style.setProperty("--swatch", color);
    b.setAttribute("aria-label", `Show ${name} items`);
    b.title = name;
    b.addEventListener("click", () => applyFilter(name));
    swatchRow.appendChild(b);
  }

  document.getElementById("lightbox-prev")!.addEventListener("click", () => show(current - 1));
  document.getElementById("lightbox-next")!.addEventListener("click", () => show(current + 1));
  document.getElementById("lightbox-close")!.addEventListener("click", () => lightbox.close());
  lightbox.addEventListener("click", (e) => {
    if (e.target === lightbox) lightbox.close();
  });

  window.addEventListener("keydown", (e) => {
    if (!lightbox.open) return;
    if (e.key === "ArrowLeft") show(current - 1);
    if (e.key === "ArrowRight") show(current + 1);
  });

  // fade items in as they enter the viewport
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add("visible");
          observer.unobserve(entry.target);
        }
      }
    },
    { rootMargin: "80px" }
  );
  document.querySelectorAll(".item").forEach((el) => observer.observe(el));
</script>

<style is:global>
  /* /junk keeps the homepage system but flips the palette to white/black */
  :root {
    --color-bg: #ffffff;
    --color-text: #111111;
    --color-accent: #111111;
  }
</style>

<style>
  .main-wrapper {
    display: flex;
    flex-direction: column;
    padding: calc(38px + var(--content-padding)) var(--content-padding) var(--content-padding);
    width: 100%;
    min-height: calc(100vh - 60px);
  }

  .junk-header {
    display: flex;
    justify-content: space-between;
    gap: var(--gap);
    padding-bottom: var(--gap);
  }

  .junk-header-right {
    display: flex;
    align-items: baseline;
    gap: calc(var(--gap) * 2);
    flex-shrink: 0;
  }

  .junk-count {
    opacity: 0.5;
  }

  .sort-btn {
    border: 0;
    background: none;
    font: inherit;
    letter-spacing: inherit;
    color: var(--color-text);
    cursor: pointer;
    padding: 0;
    opacity: 0.5;
    transition: opacity 0.2s ease;
  }

  .sort-btn:hover,
  .sort-btn.is-active {
    opacity: 1;
  }

  .sort-sep {
    opacity: 0.5;
  }

  .junk-swatches {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .swatch {
    width: 12px;
    height: 12px;
    border: 1px solid rgba(0, 0, 0, 0.25);
    background: var(--swatch);
    cursor: pointer;
    padding: 0;
    opacity: 0.55;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .swatch:hover {
    opacity: 1;
  }

  .swatch.is-active {
    opacity: 1;
    outline: 1px solid var(--color-text);
    outline-offset: 2px;
  }

  .swatch-all {
    width: auto;
    height: auto;
    border: 0;
    background: none;
    font: inherit;
    letter-spacing: inherit;
    color: var(--color-text);
    margin-right: 4px;
  }

  .swatch-all.is-active,
  .swatch-all:hover {
    opacity: 1;
  }

  .junk-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: calc(var(--gap) * 4) var(--gap);
    width: 100%;
  }

  .junk-empty {
    grid-column: 1 / -1;
    opacity: 0.5;
  }

  .item {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  .item.visible {
    opacity: 1;
    transform: none;
  }

  .item-btn {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    border: 0;
    background: none;
    cursor: pointer;
    padding: 0;
  }

  .item-btn img {
    position: absolute;
    top: 50%;
    left: 0;
    transform: translateY(-50%);
    max-width: 60%;
    max-height: 60%;
    width: auto;
    height: auto;
    transition: transform 0.25s ease;
  }
  .item-btn:hover img {
    transform: translateY(-50%) scale(1.03);
  }

  .item-meta {
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .item-meta span:last-child {
    opacity: 0.5;
  }

  dialog {
    margin: auto;
    border: 1px solid var(--color-text);
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-family);
    font-size: var(--font-size);
    font-weight: var(--font-weight);
    line-height: var(--line-height);
    letter-spacing: var(--letter-spacing);
    max-width: min(90vw, 900px);
    max-height: 90vh;
    padding: calc(var(--gap) * 3);
    text-align: center;
  }
  dialog::backdrop {
    background: rgba(255, 255, 255, 0.92);
  }
  dialog img {
    max-width: 100%;
    max-height: 70vh;
    width: auto;
    height: auto;
    margin: 0 auto;
    display: block;
  }
  .lightbox-nav {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--gap);
    margin-top: calc(var(--gap) * 2);
  }

  .lightbox-nav button {
    border: 0;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
    background: none;
    font: inherit;
    letter-spacing: inherit;
    color: var(--color-text);
    cursor: pointer;
    padding: 0;
    white-space: nowrap;
  }

  .lightbox-nav button:hover {
    border-bottom-color: var(--color-text);
  }

  #lightbox-title {
    opacity: 0.5;
  }
  #lightbox-close {
    position: absolute;
    top: var(--content-padding);
    right: var(--content-padding);
    border: 0;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
    background: none;
    font: inherit;
    letter-spacing: inherit;
    color: var(--color-text);
    cursor: pointer;
    padding: 0;
  }
  #lightbox-close:hover {
    border-bottom-color: var(--color-text);
  }

  @media (max-width: 1024px) {
    .junk-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 640px) {
    .junk-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
